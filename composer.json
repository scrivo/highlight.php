{
    "name": "scrivo/highlight.php",
    "description": "Server side syntax highlighter that supports 189 languages. It's a PHP port of highlight.js",
    "keywords": [
        "code",
        "syntax",
        "highlight",
        "highlight.js",
        "highlight.php"
    ],
    "type": "library",
    "license": "BSD-3-Clause",
    "scripts": {
        "format": "php-cs-fixer fix $(if [ ! -z $CI ]; then echo \"--format=checkstyle\"; fi)",
        "test:detection": "phpunit test/Highlight/DetectionTest.php",
        "test:markup": "phpunit test/Highlight/MarkupTest.php",
        "test": "phpunit",
        "tools": "@composer bin all install --ansi"
    },
    "support": {
        "issues": "https://github.com/scrivo/highlight.php/issues",
        "source": "https://github.com/scrivo/highlight.php"
    },
    "autoload": {
        "psr-4": {
            "Highlight\\": "src/Highlight",
            "HighlightUtilities\\": "src/HighlightUtilities"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Highlight\\Benchmark\\": "test/Benchmark",
            "Highlight\\Tests\\": "test/Highlight",
            "HighlightUtilities\\Tests\\": "test/HighlightUtilities"
        }
    },
    "authors": [
        {
            "name": "Geert Bergman",
            "homepage": "http://www.scrivo.org/",
            "role": "Project Author"
        },
        {
            "name": "Vladimir Jimenez",
            "homepage": "https://allejo.io",
            "role": "Maintainer"
        },
        {
            "name": "Martin Folkers",
            "homepage": "https://twobrain.io",
            "role": "Contributor"
        }
    ],
    "require": {
        "php": ">=7.1",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.4.1",
        "phpunit/phpunit": "^7.5.20 || ^8.5.52 || ^9.6.33 || ^10.5.62",
        "sabberworm/php-css-parser": "^8.3",
        "symfony/finder": "^4.4 || ^5.4 || ^6.4 || ^7.0",
        "symfony/var-dumper": "^4.4 || ^5.4 || ^6.4 || ^7.0"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "10.0-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true
        },
        "audit": {
            "ignore": {
                "CVE-2026-24765": "Only PHPUnit 7.5, required to test on PHP 7.1, is affected: it has no fixed release. The vulnerability is in PHPT code coverage handling, which this project does not use."
            }
        }
    }
}
